<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        One file per change, run in file name order: NNN-short-description.sql.
        Add a new change as the next number; never edit or rename a file that has already run.
    -->
    <includeAll path="changes/" relativeToChangelogFile="true" errorIfMissingOrEmpty="true"/>

</databaseChangeLog>
